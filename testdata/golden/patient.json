{
  "structureDefinitions": [
    {
      "url": "http://example.org/StructureDefinition/patient",
      "type": "Patient",
      "elements": [
        { "path": "Patient", "min": 0, "max": "*" },
        { "path": "Patient.name", "min": 1, "max": "*", "types": [{ "code": "HumanName" }] },
        { "path": "Patient.gender", "min": 0, "max": "1", "types": [{ "code": "code" }], "binding": { "strength": "required", "valueSet": "http://example.org/ValueSet/gender" } }
      ]
    }
  ],
  "searchParameters": [
    { "code": "name", "base": ["Patient"], "type": "string", "expression": "Patient.name" }
  ],
  "valueSets": [
    {
      "url": "http://example.org/ValueSet/gender",
      "composeIncludes": [
        { "system": "http://hl7.org/fhir/administrative-gender", "concepts": [{ "code": "male" }, { "code": "female" }] }
      ]
    }
  ],
  "resources": [
    {
      "profileUrl": "http://example.org/StructureDefinition/patient",
      "resource": {
        "resourceType": "Patient",
        "id": "patient-sample-1",
        "name": [{ "family": "Doe", "given": ["Jane"] }],
        "gender": "female"
      }
    }
  ]
}
