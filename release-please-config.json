{
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml",
          "edits": [
            {
              "search": "version = \"0\\.3\\.0\"",
              "replacement": "version = \"{{ version }}\""
            }
          ]
        }
      ]
    }
  }
}
